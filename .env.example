# ─── TinyFish ────────────────────────────────────────────────────────────────
# Get your key at: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your_tinyfish_api_key_here

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=opportunityradar
POSTGRES_USER=oruser
POSTGRES_PASSWORD=orpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://oruser:orpassword@db:5432/opportunityradar

# ─── API server ──────────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
APP_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=change_me_in_production_please_use_a_random_string

# ─── OAuth (all optional – hide social button if blank) ──────────────────────
# Google: https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client
#   Authorized redirect URI: http://localhost:3001/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → OAuth Apps → New
#   Authorization callback URL: http://localhost:3001/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn (Sign in with LinkedIn using OpenID Connect):
#   https://www.linkedin.com/developers/apps → Auth tab → OAuth 2.0 settings
#   Redirect URL: http://localhost:3001/api/auth/oauth/linkedin/callback
#   Required scopes: openid, profile, email
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── Alerts ──────────────────────────────────────────────────────────────────
# Email (nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
ALERT_FROM_EMAIL=your_email@gmail.com

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Worker / Scheduler ──────────────────────────────────────────────────────
# How often (minutes) to re-check each tracked source
POLL_INTERVAL_MINUTES=30

# ─── LLM (for matching & change classification) ──────────────────────────────
# Uses OpenAI-compatible API. You can point this at any compatible endpoint.
OPENAI_API_KEY=sk-proj-YOUR-KEY-HERE
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ─── Mock Portal ─────────────────────────────────────────────────────────────
MOCK_PORTAL_PORT=4000
MOCK_PORTAL_URL=http://mock-portal:4000

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
